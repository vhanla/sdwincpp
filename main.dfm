            object sldCFG: TACLSlider
              Left = 3
              Top = 135
              Width = 194
              Height = 45
              Hint = 
                'Classifier-Free Guidance : '#13#10'The CFG (Classifier-Free Guidance) ' +
                'scale is a crucial parameter in Stable Diffusion, an AI model fo' +
                'r image generation. It controls the extent to which the model fo' +
                'llows your text prompt, balancing creativity and guided generati' +
                'on. Here'#8217's a breakdown of the CFG scale and its implications:'#13#10#13 +
                #10'Default CFG Value: 7 The default CFG value is 7, which means St' +
                'able Diffusion partially draws on your input instructions while ' +
                'also using other data sources to formulate the graphic it thinks' +
                ' you'#8217'd like to see.'#13#10'Adjusting CFG Values:'#13#10#13#10'    Low CFG (1-6):' +
                ' The model enjoys more creative freedom, but may not closely fol' +
                'low your prompt. Suitable for short prompts and experimentation.' +
                #13#10'    Mid-range CFG (7-10): Recommended range for most prompts, ' +
                'balancing creativity and guided generation.'#13#10'    High CFG (11-15' +
                '): The model is more restrictive, following your prompt closely ' +
                'but potentially resulting in less creative output.'#13#10'    Very Hig' +
                'h CFG (15+): The model is highly constrained, following your pro' +
                'mpt extremely closely but potentially leading to over-interpreta' +
                'tion or lack of creativity.'#13#10#13#10'CFG Scale Impact:'#13#10#13#10'    Color Sa' +
                'turation and Contrast: Increasing the CFG setting can increase c' +
                'olor saturation and contrast, but may also compromise resolution' +
                ' quality.'#13#10'    Image Quality: Higher CFG values can result in hi' +
                'gher image quality, but may also limit the model'#8217's ability to ex' +
                'plore different artistic styles.'#13#10#13#10'Best Practices:'#13#10#13#10'    Start' +
                ' with the default CFG value (7) and adjust as needed.'#13#10'    Use s' +
                'maller steps to tweak the CFG setting until you achieve the desi' +
                'red output.'#13#10'    Experiment with different CFG values for specif' +
                'ic prompts or artistic styles.'#13#10#13#10'CFG Scale Limitations:'#13#10#13#10'    ' +
                'The CFG scale is not a direct control over the model'#8217's creativit' +
                'y, but rather a balance between creativity and guided generation' +
                '.'#13#10'    The model'#8217's ability to understand and interpret your prom' +
                'pt is still dependent on its training data and algorithms.'#13#10#13#10'Co' +
                'nclusion: The CFG scale is a powerful tool in Stable Diffusion, ' +
                'allowing you to fine-tune the balance between creativity and gui' +
                'ded generation. By understanding the implications of different C' +
                'FG values, you can effectively use this parameter to achieve the' +
                ' desired output for your image generation tasks.'
              Align = alTop
              Anchors = []
              TabOrder = 4
              Orientation = oHorizontal
              OptionsLabels.CurrentValue = 'CFG'
              OptionsLabels.MaxValue = '15.0'
              OptionsLabels.MinValue = '0.0'
              OptionsLabels.Layout = sllBeforeTrackBar
              OptionsValue.Default = 7.000000000000000000
              OptionsValue.Max = 15.000000000000000000
              OptionsValue.Page = 1.000000000000000000
              OptionsValue.Paginate = True
              Position = 15.000000000000000000
              OnChange = sldCFGChange
            end
